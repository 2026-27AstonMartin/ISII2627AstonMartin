@startuml
class Competicion {
    + Id : int <<get>> <<set>>
    + Nombre : string <<get>> <<set>>
    + Plazas : int <<get>> <<set>>
    + Lugar : string <<get>> <<set>>
    + Precio : decimal <<get>> <<set>>
    + TipoDeporteId : int <<get>> <<set>>
}
Competicion --> "Fecha" DateTime
Competicion o-> "TipoDeporte" TipoDeporte
@enduml
