@startuml
class Inscripcion {
    + Id : int <<get>> <<set>>
    + <<required>> NombreUsuario : string <<get>> <<set>>
    + <<required>> ApellidosUsuario : string <<get>> <<set>>
    + <<required>> DNI : string <<get>> <<set>>
    + <<required>> Telefono : string <<get>> <<set>>
    + PrecioTotal : decimal <<get>> <<set>>
    + <<required>> DatosPago : string <<get>> <<set>>
    + <<required>> ClienteId : string <<get>> <<set>>
    + CompeticionesInscritas : IList<CompeticionInscrita> <<get>> <<set>>
}
Inscripcion --> "FechaInscripcion" DateTime
Inscripcion --> "MetodoPago" MetodoPago
Inscripcion --> "Cliente" ApplicationUser
@enduml
